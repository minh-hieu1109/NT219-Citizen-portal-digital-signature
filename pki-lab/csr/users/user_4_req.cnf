[ req ]
    default_bits        = 2048
    prompt              = no
    default_md          = sha256
    distinguished_name  = req_distinguished_name

    [ req_distinguished_name ]
    C  = VN
    ST = HCM
    L  = HCM
    O  = Citizen Portal
    OU = Citizen
    CN = citi3
    emailAddress = citizen3@example.com
    